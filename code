// clientSocket.cpp
#include "includes/clientSocket.hpp"
#include <sys/socket.h>
#include <unistd.h>

ClientSocket::ClientSocket() : _fd(-1) {}

ClientSocket::ClientSocket(int fd) : _fd(fd)
{
    if (_fd.isValid())
        _fd.setNonBlocking();
}

ClientSocket::~ClientSocket()
{
    close();
}

ssize_t ClientSocket::receive(char* buffer, size_t size)
{
    if (!_fd.isValid())
        return (-1);
    
    return (recv(_fd.get(), buffer, size, 0));
}

ssize_t ClientSocket::send(const char* data, size_t size)
{
    if (!_fd.isValid())
        return (-1);
    
    return (::send(_fd.get(), data, size, 0));
}

void ClientSocket::close()
{
    _fd.close();
}

int ClientSocket::getPollFd() const
{
    return (_fd.get());
}

bool ClientSocket::isValid() const
{
    return (_fd.isValid());
}
