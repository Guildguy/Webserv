// server.cpp
#include "includes/server.hpp"
#include <iostream>

Server::Server() {}

Server::~Server() {}

bool Server::initialize(int port, const std::string& ip)
{
    if (!_serverSocket.initialize(port, ip))
        return (handleError("Failed to initialize socket"));
    
    if (!_serverSocket.bind())
        return (handleError("Failed to bind socket"));
    
    if (!_serverSocket.listen(SOMAXCONN))
        return (handleError("Failed to listen on socket"));
    
    // Prepara poll do servidor
    pollfd serverPoll;
    serverPoll.fd = _serverSocket.getPollFd();
    serverPoll.events = POLLIN;
    serverPoll.revents = 0;
    _pollFds.push_back(serverPoll);
    
    return (true);
}

void Server::run()
{
    while (true)
    {
        int ret = poll(_pollFds.data(), _pollFds.size(), -1);
        
        if (ret < 0)
        {
            handleError("poll failed");
            break;
        }
        
        for (size_t i = 0; i < _pollFds.size(); i++)
        {
            if (!(_pollFds[i].revents & POLLIN))
                continue;
            
            if (i == 0)
            {
                acceptNewClient();
                continue;
            }
            
            handleClientData(i);
        }
    }
}

void Server::acceptNewClient()
{
    int clientFd = _serverSocket.accept();
    
    // Sem verificação de errno - apenas valida retorno
    if (clientFd < 0)
        return;
    
    ClientSocket client(clientFd);
    
    if (!client.isValid())
    {
        client.close();
        return;
    }
    
    // Adiciona ao poll
    pollfd clientPoll;
    clientPoll.fd = client.getPollFd();
    clientPoll.events = POLLIN;
    clientPoll.revents = 0;
    _pollFds.push_back(clientPoll);
    
    std::cout << "New client connected: fd " << clientFd << std::endl;
}

void Server::handleClientData(size_t index)
{
    char buffer[1024];
    int clientFd = _pollFds[index].fd;
    ClientSocket client(clientFd);
    
    ssize_t bytesRead = client.receive(buffer, sizeof(buffer));
    
    // Sem errno - apenas trata retorno
    if (bytesRead <= 0)
    {
        std::cout << "Client disconnected: fd " << clientFd << std::endl;
        client.close();
        _pollFds.erase(_pollFds.begin() + index);
        return;
    }
    
    std::cout << "Received " << bytesRead << " bytes: " 
              << std::string(buffer, bytesRead) << std::endl;
}

bool Server::handleError(const std::string& msg)
{
    perror(msg.c_str());
    return (false);
}

