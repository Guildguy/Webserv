// serverSocket.cpp
#include "includes/serverSocket.hpp"
#include <sys/socket.h>
#include <arpa/inet.h>
#include <unistd.h>

ServerSocket::ServerSocket() {}

ServerSocket::~ServerSocket() {}

bool ServerSocket::initialize(int port, const std::string& ip)
{
    if (!createSocket())
        return (false);
    if (!configureAddress(port, ip))
        return (false);
    return (true);
}

bool ServerSocket::createSocket()
{
    int fd = socket(AF_INET, SOCK_STREAM, 0);
    _fd = FileDescriptor(fd);
    
    if (!_fd.isValid())
        return (false);
    if (!_fd.setNonBlocking())
        return (false);
        
    // Set SO_REUSEADDR
    int opt = 1;
    if (setsockopt(_fd.get(), SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt)) < 0)
        return (false);
    
    return (true);
}

bool ServerSocket::configureAddress(int port, const std::string& ip)
{
    _address.sin_family = AF_INET;
    _address.sin_port = htons(port);
    
    if (ip == "0.0.0.0" || ip.empty())
        _address.sin_addr.s_addr = INADDR_ANY;
    else
    {
        in_addr_t addr = inet_addr(ip.c_str());
        if (addr == INADDR_NONE)
            return (false);
        _address.sin_addr.s_addr = addr;
    }
    return (true);
}

// ✅ ServerSocket tem a responsabilidade de bind
bool ServerSocket::bind()
{
    if (::bind(_fd.get(), (sockaddr*)&_address, sizeof(_address)) < 0)
        return (false);
    return (true);
}

// ✅ ServerSocket tem a responsabilidade de listen
bool ServerSocket::listen(int backlog)
{
    if (::listen(_fd.get(), backlog) < 0)
        return (false);
    return (true);
}

// ✅ ServerSocket tem a responsabilidade de accept
int ServerSocket::accept()
{
    return (::accept(_fd.get(), NULL, NULL));
}

int ServerSocket::getPollFd() const
{
    return (_fd.get());
}

bool ServerSocket::isValid() const
{
    return (_fd.isValid());
}

